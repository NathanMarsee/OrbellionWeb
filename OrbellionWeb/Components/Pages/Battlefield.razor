@page "/battlefield"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using OrbellionWeb.Components.UIElements
@using OrbellionWeb.Data
@using OrbellionWeb.Models
@using OrbellionWeb.Shared
@using System.Security.Claims
@rendermode InteractiveServer
@inject IDbContextFactory<OrbellionWebContext> _contextFactory
@inject AuthenticationStateProvider _authenticationStateProvider
@attribute [Authorize]

<PageTitle>Battlefield</PageTitle>

<h1>Cards</h1>


@if (!inBattle)
{
    <button class="btn btn-primary" @onclick="JoinBattleAsync">Join Battle</button>
}
else
{
    <div>
        <button class="btn btn-primary" @onclick="AddCard">New Card</button>
    </div>
}

<div class="battlefield dropzonebattlefield" style="width: auto; max-width: 80%; height: 800px; position: relative; background-color: lightgray;">
    @foreach (var card in battlefieldCards)
    {
        <CardVisual @key="card.Id" DisplayedCard="card" CardClass="battlefieldCard card no-select" OnDropped="@OnBattlefieldCardDropped"></CardVisual>
    }
    @foreach (var hellion in hellions)
    {
        <HellionVisual @key="hellion.Id" DisplayedHellion="hellion"></HellionVisual>
    }
</div>
<div class="lower-section" style="width: auto; max-width: 80%; display: flex;">
    <div class="deck" style="width: fit-content; min-width: 200px; min-height: 255px; background-color: darkgray; display: inline-block; white-space: nowrap; padding: 12px;">
        <div class="row" style="height: 15%; justify-content: center">
            <button @onclick="Draw" style="width: fit-content">D</button>
            <button @onclick="Deck.Shuffle" style="width: fit-content">S</button>
            <button @onclick="SearchDeck" style="width: fit-content">T</button>
        </div>
        @if (Searching)
        {
            <div style="display: flex; flex-direction: column">
            @foreach (var card in Deck.Cards)
            {
                <button @onclick="(() => Tutor(card.Id))">@card.Name</button>
            }
            </div>
        }
        else
        {
            <div class="row" style="height: 85%">
                <div class="dropzonetopdeck" OnDropped="@OnTopDeckCardDropped">Top</div>
                <div class="dropzonebottomdeck" OnDropped="@OnBottomDeckCardDropped">Bottom</div>
            </div>
        }
    </div>
    <div class="hand dropzonehand" style="width: 100%; min-height: 255px; background-color: gray; display: inline-block; overflow-x: auto; white-space: nowrap; padding: 10px;">
        <SortableList Items="handCards" Context="card" OnUpdate="SortList" Filter=".no-drag" ContainerStyle="display:flex; gap:10px; align-items:flex-start;">
            <SortableItemTemplate>
                <CardVisual @key="card.Id" DisplayedCard="card" CardClass="handCard card no-select" OnDropped="@OnHandCardDropped"></CardVisual>
            </SortableItemTemplate>
        </SortableList>
    </div>
</div>

@code {
    private List<Card> battlefieldCards = new List<Card>();
    private List<Card> handCards = new List<Card>();
    private Deck Deck = new Deck();
    private List<Hellion> hellions = new List<Hellion>();
    private bool inBattle = false;
    private bool Searching = false;

    private void AddCard()
    {
        handCards.Add(new Card());
    }

    private async Task JoinBattleAsync()
    {
        var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        using var context = _contextFactory.CreateDbContext();
        {
            var currentUser = context.Users.Where(u => u.Id == userId)
                                           .Include(u => u.Cards)
                                           .Include(u => u.Hellions)
                                           .Include(u => u.Staples).FirstOrDefault();

            if (currentUser != null)
            {
                Deck = new Deck(currentUser.Cards);
                inBattle = true;
            }
        }
        ;
    }

    private void Draw()
    {
        var card = Deck.Draw();
        if (card != null)
        {
            handCards.Add(card);
        }
    }


    /*private void AddHellion()
    {
        hellions.Add(new Hellion());
    }*/

    private async Task OnBattlefieldCardDropped(Guid cardId)
    {
        var card = battlefieldCards.FirstOrDefault(c => c.Id == cardId);
        if (card != null)
        {
            battlefieldCards.Remove(card);
            handCards.Add(card);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnHandCardDropped(Guid cardId)
    {
        var card = handCards.FirstOrDefault(c => c.Id == cardId);
        if (card != null)
        {
            handCards.Remove(card);
            battlefieldCards.Add(card);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnTopDeckCardDropped(Guid cardId)
    {
        var card = handCards.Concat(battlefieldCards).FirstOrDefault(c => c.Id == cardId);
        if (card != null)
        {
            Deck.PutOnTop(card);
        }

    }

    private void OnBottomDeckCardDropped(Guid cardId)
    {
        var card = handCards.Concat(battlefieldCards).FirstOrDefault(c => c.Id == cardId);
        if (card != null)
        {
            Deck.PutOnBottom(card);
        }
    }

    private void SearchDeck()
    {
        Searching = !Searching;
    }

    private void Tutor(Guid cardId)
    {
        var card = Deck.Tutor(cardId);
        if (card != null)
        {
            handCards.Add(card);
            Searching = false;
        }
    }

    private async Task SortList((int oldIndex, int newIndex) args)
    {
        var card = handCards[args.oldIndex];
        handCards.RemoveAt(args.oldIndex);
        handCards.Insert(args.newIndex, card);
        await InvokeAsync(StateHasChanged);
    }
}
