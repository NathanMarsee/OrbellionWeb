<!-- using Microsoft.EntityFrameworkCore -->
<!-- using Microsoft.EntityFrameworkCore.Internal -->
<!-- using OrbellionWeb.Data -->
@using OrbellionWeb.Shared
@using OrbellionWeb.Models
<!-- inject IDbContextFactory<OrbellionWebContext> _contextFactory -->

<div class="staple card">
    <div class="title"><textarea type="text" @bind="@DisplayedStaple.Name" @bind:after="SaveStaple" placeholder="Staple Name" rows="1" /></div>
    <div class="typeline">
        <InputSelect class="no-drag" @bind-Value="@DisplayedStaple.Element" @bind-Value:after="SaveStaple" style="border: none;">
            @foreach (var value in Enum.GetValues(typeof(Element)))
            {
                <option value="@value">@value</option>
            }
        </InputSelect>
    </div>
    <div class="text">
        <textarea type="text" @bind="@DisplayedStaple.Text" @bind:after="SaveStaple" placeholder="Staple Text" rows="2" />
    </div>
</div>

@code {
    [Parameter]
    public Staple DisplayedStaple { get; set; } = new Staple();

    [Parameter]
    public string StapleClass { get; set; } = "staple";

